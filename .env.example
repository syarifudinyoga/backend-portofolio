# GitHub username or organization that owns the GHCR package
GHCR_OWNER=your-github-username
API_IMAGE=portfolio-api
IMAGE_TAG=latest

# Change this before starting the database
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-this-to-a-long-random-password

# API HTTP bind address and port
API_BIND_ADDRESS=0.0.0.0
API_PORT=8080
